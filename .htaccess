# AK Computer - Apache config
Options -Indexes

# Some PHP-FPM/CGI/suPHP setups on shared hosting strip the Authorization
# header before it reaches PHP - api.php's Bearer-token auth needs it, so
# pass it through explicitly rather than relying on $_SERVER['HTTP_AUTHORIZATION'].
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTP:Authorization} ^(.*)
  RewriteRule .* - [E=HTTP_AUTHORIZATION:%1]

  # SEO pretty URLs (the plain ?id= URLs still work and canonical-tag here)
  RewriteRule ^sitemap\.xml$ sitemap.php [L]
  RewriteRule ^sitemap-([a-z]+)\.xml$ sitemap.php?part=$1 [L]
  RewriteRule ^p/([0-9]+)(/.*)?$ product.php?id=$1 [L,QSA]
  RewriteRule ^price/([0-9]+)(/.*)?$ price.php?id=$1 [L,QSA]
  RewriteRule ^c/([A-Za-z0-9-]+)/?$ category.php?s=$1 [L,QSA]
  RewriteRule ^b/([A-Za-z0-9-]+)/?$ brand.php?s=$1 [L,QSA]
  RewriteRule ^s/([A-Za-z0-9-]+)/?$ services.php?s=$1 [L,QSA]
  RewriteRule ^s/?$ services.php [L]
  RewriteRule ^privacy/?$ privacy.php [L]
  RewriteRule ^terms/?$ terms.php [L]
</IfModule>

# compress text responses (page speed = ranking factor)
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json application/xml image/svg+xml
</IfModule>

<FilesMatch "^(config\.php|config\.sample\.php)$">
  Require all denied
</FilesMatch>

# basic caching for assets
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css "access plus 7 days"
  ExpiresByType application/javascript "access plus 7 days"
  ExpiresByType image/svg+xml "access plus 30 days"
  ExpiresByType image/png "access plus 30 days"
  ExpiresByType image/jpeg "access plus 30 days"
</IfModule>
