# uploads: images only, never execute scripts
<FilesMatch "\.(php|phtml|php3|php4|php5|pl|py|cgi|sh)$">
  Require all denied
</FilesMatch>
# error logs, database backups and cached dashboard data are never web-readable
# (json covers uploads/cache/, which also has its own deny file - two layers,
# because a single missing .htaccess should never expose shop figures)
<FilesMatch "\.(log|sql|gz|enc|json)$">
  Require all denied
</FilesMatch>
<IfModule mod_php.c>
  php_flag engine off
</IfModule>
# anything that a browser could execute as a document in our origin is
# handed over as a download instead of being rendered (old SVG logos
# uploaded before the raster-only rule, stray html/xml)
<IfModule mod_headers.c>
  <FilesMatch "\.(svg|svgz|html?|xht|xml)$">
    Header set Content-Disposition "attachment"
    Header set X-Content-Type-Options "nosniff"
  </FilesMatch>
</IfModule>
